
OUTPUT = $(CURDIR)/output-clang
CCACHE =
LLVM_SRCDIR = LLVM_SRCDIR_not_set
MUSL_SRCDIR = MUSL_SRCDIR_not_set
MINGW_SRCDIR = MINGW_SRCDIR_not_set

TARGETS = \
	aarch64-linux-musl \
	arm-linux-musleabihf \
	armv6-linux-musleabi \
	armv6-linux-musleabihf \
	armv7-linux-musleabi \
	armv7-linux-musleabihf \
	loongarch64-linux-musl \
	s390x-linux-musl \
	mips-linux-musl \
	mips-linux-muslsf \
	mipsel-linux-musl \
	mipsel-linux-muslsf \
	mips64-linux-musl \
	mips64-linux-muslsf \
	mips64el-linux-musl \
	mips64el-linux-muslsf \
	powerpc64-linux-musl \
	powerpc64le-linux-musl \
	riscv64-linux-musl \
	i586-linux-musl \
	i686-linux-musl \
	x86_64-linux-musl \
	# end

TARGET_CONFIG_armv7-linux-musleabihf = -mfpu=vfpv3

# ARM baselines, kept at armv6kz+vfpv2 to match the gcc-mode toolchain and
# Alpine's armhf baseline (ARM1176/RPi1 class). Upstream compiler-rt's
# optimized arm FP assembly requires ARMv6T2 (mls/movw), so those targets
# build builtins with COMPILER_RT_ARM_OPTIMIZED_FP=OFF (Alpine's approach),
# which falls back to the portable C implementations; armv7 keeps them on.
TARGET_CONFIG_arm-linux-musleabihf = -march=armv6kz -mfpu=vfpv2
TARGET_CONFIG_armv6-linux-musleabihf = -march=armv6kz -mfpu=vfpv2
TARGET_CONFIG_armv6-linux-musleabi = -march=armv6kz

# 32-bit ARM targets whose baseline lacks ARMv6T2
ARM_V6_TARGETS = arm-linux-musleabihf armv6-linux-musleabihf armv6-linux-musleabi

# mingw-w64 (windows-gnu) targets, mirroring the gcc-mode target set. The CRT,
# winpthreads and compiler-rt builtins are built with the just-built clang +
# lld + llvm tools, the same arrangement llvm-mingw ships.
MINGW_TARGETS = i586-w64-mingw32 i686-w64-mingw32 x86_64-w64-mingw32 aarch64-w64-mingw32
MINGW_CRT_CONFIG_i586-w64-mingw32 = --enable-lib32 --disable-lib64
MINGW_CRT_CONFIG_i686-w64-mingw32 = --enable-lib32 --disable-lib64
MINGW_CRT_CONFIG_x86_64-w64-mingw32 = --disable-lib32 --enable-lib64
MINGW_CRT_CONFIG_aarch64-w64-mingw32 = --disable-lib32 --disable-lib64 --enable-libarm64

# https://github.com/llvm/llvm-project/issues/58377
# https://github.com/ziglang/zig/issues/4925
$(foreach t,$(TARGETS), \
$(if $(findstring mips,$(t)),$(eval TARGET_CONFIG_$(t) = -Wl,-z,notext )) \
)

DEFAULT_TARGET = x86_64-linux-musl

TOOLS = \
	llvm-ar \
	llvm-dlltool \
	llvm-nm \
	llvm-objcopy \
	llvm-objdump \
	llvm-ranlib \
	llvm-size \
	llvm-strip \
	llvm-readobj \
	llvm-strings \
	llvm-rc \
	# end

-include config.mak

HOSTCC ?= $(CC)

# llvm 13.0.0 switched to using normalized target triples for runtimes.
# Convert 3-part triples to 4-part by adding 'unknown' vendor
define normalise_target
$(if $(findstring $(words $(subst -, ,$(1))),3),$(subst -linux-,-unknown-linux-,$(1)),$(1))
endef

define normalise_targets
$(foreach t,$(1),$(call normalise_target,$(t)))
endef

fn_major_version = $(firstword $(subst ., ,$(1)))

# https://github.com/llvm/llvm-project/tree/main/llvm/lib/Target
llvm_target_map = \
	aarch64%:AArch64 \
	arm%:ARM \
	i%86:X86 \
	mips%:Mips \
	powerpc%:PowerPC \
	riscv%:RISCV \
	s390%:SystemZ \
	x86_64:X86 \
	loongarch%:LoongArch \
	m68k:M68k \
	# end

define llvm_target
$(or
  $(filter-out !%,
    $(foreach m,$(llvm_target_map),
      $(patsubst !$(word 1,$(subst :, ,$(m))),$(word 2,$(subst :, ,$(m))),!$(call fn_target_arch,$(1))))),
  $(error Cannot determine LLVM target architecture for target $(1)))
endef

define llvm_targets
$(sort $(foreach t,$(1),$(call llvm_target,$(t))))
endef

ifeq ($(shell uname -s),Darwin)
STAT =
else
# -no-pie: Alpine gcc defaults to PIE, turning -static into static-pie whose
# x86_64 self-relocation crashes the linked tools at startup
STAT = -static --static -no-pie
endif

# Shell script to fix broken symlinks with absolute /lib/* paths
# Usage: cd target_lib_dir && $(FIX_LIB_SYMLINKS)
define FIX_LIB_SYMLINKS
find . -type l | while read link; do \
	target=$$(readlink "$$link") || continue; \
	case "$$target" in \
		/lib/*) \
			real_target=$${target#/lib/}; \
			rm -f "$$link" && ln -sf "$$real_target" "$$link"; \
			;; \
	esac; \
done
endef

COMMON_FLAGS = -O2 -g0 -Wno-error -w
COMMON_LD_FLAGS = -s
EXE_LD_FLAGS = $(COMMON_LD_FLAGS) $(STAT)

# clang-cl/lld-link link against clang_rt.builtins.lib for the windows-msvc
# targets. compiler-rt's cmake cannot cross-configure those targets on a POSIX
# host without a Windows SDK (it switches to cl-style flags whose deps=msvc
# dependency tracking ninja rejects off Windows, and a few sources include
# libc headers), so compile the builtins sources directly with the built
# clang instead. Sources are filtered to the set upstream itself builds for
# msvc: x87 long-double code (MSVC long double == double), crtbegin,
# enable_execute_stack, eprintf, emutls and int_util need libc/ELF support
# and are dropped; __compilerrt_abort_impl is provided as a trap, matching
# the upstream freestanding build.
WIN_BUILTIN_TARGETS = x86_64-pc-windows-msvc aarch64-pc-windows-msvc
WIN_BUILTIN_ARCH_x86_64-pc-windows-msvc = x86_64
WIN_BUILTIN_ARCH_aarch64-pc-windows-msvc = aarch64
WIN_BUILTIN_EXCLUDE = crtbegin divxc3 emutls enable_execute_stack eprintf \
	extendhfxf2 fixunsxfdi fixunsxfsi fixunsxfti fixxfdi fixxfti floatdixf \
	floattixf floatundixf floatuntixf int_util mulxc3 powixf2 truncxfhf2
WIN_BUILTIN_GENERIC_SRCS := $(filter-out $(WIN_BUILTIN_EXCLUDE),$(notdir $(basename $(wildcard src_llvm/compiler-rt/lib/builtins/*.c))))
WIN_BUILTIN_SRCS_x86_64 := $(filter-out $(WIN_BUILTIN_EXCLUDE),$(notdir $(basename $(wildcard src_llvm/compiler-rt/lib/builtins/x86_64/*.c))))
WIN_BUILTIN_SRCS_aarch64 := $(filter-out $(WIN_BUILTIN_EXCLUDE),$(notdir $(basename $(wildcard src_llvm/compiler-rt/lib/builtins/aarch64/*.c))))

export CFLAGS = $(COMMON_FLAGS)
export CXXFLAGS = $(COMMON_FLAGS)

# DLLVM_ENABLE_PROJECTS='clang;clang-tools-extra;cross-project-tests;libc;libclc;lld;lldb;openmp;polly;pstl'
# DLLVM_ENABLE_RUNTIMES='compiler-rt;libc;libcxx;libcxxabi;libunwind;openmp'
FULL_LLVM_CONFIG = $(LLVM_CONFIG) \
	-Wno-dev \
	$(if $(filter ccache,$(CCACHE)),-DLLVM_CCACHE_BUILD=ON) \
	-DLLVM_ENABLE_BINDINGS=OFF \
	-DCLANG_PLUGIN_SUPPORT=ON \
	-DLIBCLANG_BUILD_STATIC=ON \
	-DCLANG_DEFAULT_PIE_ON_LINUX=ON \
	-DLLVM_ENABLE_RTTI=ON \
	-DCMAKE_BUILD_WITH_INSTALL_RPATH=OFF \
	-DCMAKE_SKIP_INSTALL_RPATH=ON \
	-DLLVM_APPEND_VC_REV=OFF \
	-DLLVM_ENABLE_ASSERTIONS=OFF \
	-DLLVM_ENABLE_PIC=ON \
	-DLLVM_ENABLE_FFI=OFF \
	-DLLVM_ENABLE_LIBEDIT=OFF \
	-DLLVM_ENABLE_CURL=OFF \
	-DLLVM_ENABLE_TERMINFO=OFF \
	-DLLVM_ENABLE_LIBPFM=OFF \
	-DLLVM_ENABLE_WARNINGS=OFF \
	-DLLVM_ENABLE_ZLIB=FORCE_ON \
	-DZLIB_LIBRARY=$(CURDIR)/obj_zlib/lib/libz.a \
	-DZLIB_INCLUDE_DIR=$(CURDIR)/obj_zlib/include \
	-DLLVM_ENABLE_ZSTD=FORCE_ON \
	-Dzstd_LIBRARY=$(CURDIR)/obj_zstd/libzstd.a \
	-Dzstd_INCLUDE_DIR=$(CURDIR)/obj_zstd \
	-DLLVM_ENABLE_LIBXML2=FORCE_ON \
	-DLIBXML2_LIBRARY=$(CURDIR)/obj_libxml2/lib/libxml2.a \
	-DLIBXML2_INCLUDE_DIR=$(CURDIR)/obj_libxml2/include/libxml2 \
	-DLLVM_ENABLE_BACKTRACES=OFF \
	-DLLVM_INCLUDE_BENCHMARKS=OFF \
	-DLLVM_INCLUDE_EXAMPLES=OFF \
	-DLLVM_INCLUDE_TESTS=OFF \
	-DLLVM_BUILD_DOCS=OFF \
	-DLLVM_BUILD_EXAMPLES=OFF \
	-DLLVM_BUILD_TESTS=OFF \
	-DCMAKE_C_FLAGS="$(COMMON_FLAGS)" \
	-DCMAKE_CXX_FLAGS="$(COMMON_FLAGS)" \
	-DCMAKE_EXE_LINKER_FLAGS="$(EXE_LD_FLAGS)" \
	-DLLVM_STATIC_LINK_CXX_STDLIB=ON \
	-DBUILD_SHARED_LIBS=OFF \
	-DLLVM_BUILD_LLVM_DYLIB=OFF \
	-DLLVM_LINK_LLVM_DYLIB=OFF \
	-DCLANG_DEFAULT_CXX_STDLIB=libc++ \
	-DCLANG_DEFAULT_LINKER=lld \
	-DCLANG_DEFAULT_OBJCOPY=llvm-objcopy \
	-DCLANG_DEFAULT_RTLIB=compiler-rt \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_INSTALL_DO_STRIP=1 \
	-DCMAKE_INSTALL_PREFIX=/clang \
	-DLLVM_BUILTIN_TARGETS='$(subst $(subst ,, ),;,$(call normalise_targets,$(TARGETS)));$(subst $(subst ,, ),;,$(MINGW_TARGETS))' \
	-DLLVM_DEFAULT_TARGET_TRIPLE=$(DEFAULT_TARGET) \
	-DLLVM_DISTRIBUTION_COMPONENTS='clang;clang-resource-headers;lld;LTO;$(subst $(subst ,, ),;,$(TOOLS))' \
	-DLLVM_ENABLE_PROJECTS='clang;clang-tools-extra;lld' \
	-DLLVM_ENABLE_RUNTIMES='compiler-rt;libcxx;libcxxabi;libunwind' \
	-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON \
	-DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
	-DLLVM_RUNTIME_TARGETS='$(subst $(subst ,, ),;,$(call normalise_targets,$(TARGETS)));$(subst $(subst ,, ),;,$(MINGW_TARGETS))' \
	-DLLVM_TARGETS_TO_BUILD='$(subst $(subst ,, ),;,$(call llvm_targets,$(TARGETS)))' \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_SYSROOT=$(CURDIR)/obj_sysroot/$(t)) \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_SYSTEM_NAME=Linux) \
	$(foreach t,$(MINGW_TARGETS),-DBUILTINS_$(t)_CMAKE_SYSTEM_NAME=Windows) \
	$(foreach t,$(MINGW_TARGETS),-DBUILTINS_$(t)_CMAKE_SYSROOT=$(CURDIR)/obj_sysroot/$(t)) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_SYSTEM_NAME=Linux) \
	$(foreach t,$(MINGW_TARGETS),-DRUNTIMES_$(t)_CMAKE_SYSTEM_NAME=Windows) \
	$(foreach t,$(MINGW_TARGETS),-DRUNTIMES_$(t)_CMAKE_SYSROOT=$(CURDIR)/obj_sysroot/$(t)) \
	$(foreach t,$(MINGW_TARGETS),-DRUNTIMES_$(t)_LLVM_ENABLE_RUNTIMES=libunwind) \
	$(foreach t,$(MINGW_TARGETS),-DRUNTIMES_$(t)_LIBUNWIND_ENABLE_SHARED=OFF) \
	$(foreach t,$(MINGW_TARGETS),-DRUNTIMES_$(t)_LIBUNWIND_USE_COMPILER_RT=ON) \
	$(foreach t,$(ARM_V6_TARGETS),-DBUILTINS_$(call normalise_target,$(t))_COMPILER_RT_ARM_OPTIMIZED_FP=OFF) \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_EXE_LINKER_FLAGS='$(EXE_LD_FLAGS) $(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_SHARED_LINKER_FLAGS='$(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_CXX_FLAGS='$(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_C_FLAGS='$(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DBUILTINS_$(call normalise_target,$(t))_CMAKE_ASM_FLAGS='$(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_EXE_LINKER_FLAGS='$(EXE_LD_FLAGS) $(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_SHARED_LINKER_FLAGS='$(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_CXX_FLAGS='$(TARGET_CONFIG_$(t)) -L$(CURDIR)/obj_musl/$(t)/lib -B$(CURDIR)/obj_musl/$(t)/lib -Qunused-arguments') \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_C_FLAGS='$(TARGET_CONFIG_$(t)) -L$(CURDIR)/obj_musl/$(t)/lib -B$(CURDIR)/obj_musl/$(t)/lib -Qunused-arguments') \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_ASM_FLAGS='$(TARGET_CONFIG_$(t))') \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_CMAKE_SYSROOT=$(CURDIR)/obj_sysroot/$(t)) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_CTX_PROFILE=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_GWP_ASAN=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_LIBFUZZER=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_MEMPROF=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_PROFILE=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_SANITIZERS=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_COMPILER_RT_BUILD_XRAY=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXXABI_ENABLE_SHARED=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXXABI_ENABLE_STATIC_UNWINDER=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXXABI_INSTALL_LIBRARY=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXXABI_USE_COMPILER_RT=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXXABI_USE_LLVM_UNWINDER=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXXABI_STATICALLY_LINK_UNWINDER_IN_SHARED_LIBRARY=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXX_ENABLE_STATIC_ABI_LIBRARY=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXX_HAS_MUSL_LIBC=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBCXX_USE_COMPILER_RT=ON) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBUNWIND_ENABLE_SHARED=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBUNWIND_INSTALL_LIBRARY=OFF) \
	$(foreach t,$(TARGETS),-DRUNTIMES_$(call normalise_target,$(t))_LIBUNWIND_USE_COMPILER_RT=ON) \
	# end

all: llvm musl mingw

install: install-llvm install-musl install-zlib install-kernel-headers install-configs install-winbuiltins install-mingw install-symlinks

llvm: | obj_llvm/.lc_built_3
musl: | $(foreach t,$(TARGETS),obj_musl/$(t)/.lc_built)
mingw: | $(foreach t,$(MINGW_TARGETS),obj_mingw_pthreads/$(t)/.lc_built)
install-musl: $(foreach t,$(TARGETS),install-musl_$(t))
install-zlib: $(foreach t,$(TARGETS),install-zlib_$(t))
install-kernel-headers: $(foreach t,$(TARGETS),install-kernel-headers_$(t))
install-configs: $(foreach t,$(TARGETS) $(MINGW_TARGETS),install-configs_$(t))
install-winbuiltins: $(foreach t,$(WIN_BUILTIN_TARGETS),install-winbuiltins_$(t))
install-symlinks: $(foreach t,$(TARGETS) $(MINGW_TARGETS),install-symlinks_$(t))
install-mingw: $(foreach t,$(MINGW_TARGETS),install-mingw_$(t))

.PHONY: all llvm musl mingw install-llvm install-musl install-kernel-headers install-configs install-winbuiltins install-mingw install-symlinks clean

src_llvm: | $(LLVM_SRCDIR)
	ln -sf $(LLVM_SRCDIR) $@

src_musl: | $(MUSL_SRCDIR)
	ln -sf $(MUSL_SRCDIR) $@

src_mingw: | $(MINGW_SRCDIR)
	ln -sf $(MINGW_SRCDIR) $@

src_kernel_headers: | $(LINUX_SRCDIR)
	ln -sf "$(LINUX_SRCDIR)" $@

src_zlib: | $(ZLIB_SRCDIR)
	ln -sf $(ZLIB_SRCDIR) $@

src_zstd: | $(ZSTD_SRCDIR)
	ln -sf $(ZSTD_SRCDIR) $@

src_libxml2: | $(LIBXML2_SRCDIR)
	ln -sf $(LIBXML2_SRCDIR) $@
	rm -f $@/test/icu_parse_test.xml

%/:
	mkdir -p $@

obj_llvm/.lc_configured: | obj_llvm/ src_llvm obj_zlib/.lc_built obj_zstd/.lc_built obj_libxml2/.lc_built
	cd obj_llvm && cmake -G "Ninja" $(FULL_LLVM_CONFIG) ../src_llvm/llvm
	touch $@

obj_llvm/.lc_built_1: | obj_llvm/.lc_configured
	cd obj_llvm && ninja distribution
	touch $@

# llvm 16+ has only the major version number in the LIBCC path
obj_musl/%/.lc_configured: | obj_musl/%/ src_musl obj_llvm/.lc_built_1
	cd obj_musl/$* && sh ../../src_musl/configure \
		--prefix= \
		--target=$* \
		--disable-wrapper \
		LIBCC=../../obj_llvm/lib/clang/$(if $(intcmp $(call fn_major_version,$(LLVM_VER)),16),$(LLVM_VER),$(call fn_major_version,$(LLVM_VER)))/lib/$(call normalise_target,$*)/libclang_rt.builtins.a \
		CC="$(CCACHE) ../../obj_llvm/bin/clang --target=$* $(TARGET_CONFIG_$*)" \
		$(MUSL_CONFIG) $(MUSL_CONFIG_$*)
	touch $@

obj_sysroot/%/.lc_headers: | obj_sysroot/ obj_musl/%/.lc_configured
	cd obj_musl/$* && $(MAKE) DESTDIR=$(CURDIR)/obj_sysroot/$* install-headers
	touch $@

obj_llvm/.lc_built_2: | $(foreach t,$(TARGETS),obj_sysroot/$(t)/.lc_headers obj_sysroot/$(t)/.lc_linux_headers) $(foreach t,$(MINGW_TARGETS),obj_sysroot/$(t)/.lc_mingw_headers)
	cd obj_llvm && ninja builtins
	touch $@

obj_musl/%/.lc_built: | obj_musl/%/.lc_configured obj_llvm/.lc_built_2
	cd obj_musl/$* && $(MAKE) AR=../../obj_llvm/bin/llvm-ar \
				  RANLIB=../../obj_llvm/bin/llvm-ranlib
	touch $@

obj_zlib/.lc_configured: export CC := $(CCACHE) $(CC)
obj_zlib/.lc_configured: | obj_zlib/ src_zlib
	cd obj_zlib && sh ../src_zlib/configure --prefix= --static
	touch $@

obj_zlib/%/.lc_configured: export CC = $(CCACHE) $(DESTDIR)$(OUTPUT)/bin/$*-clang
obj_zlib/%/.lc_configured: export AR = $(DESTDIR)$(OUTPUT)/bin/$*-ar
obj_zlib/%/.lc_configured: export RANLIB = $(DESTDIR)$(OUTPUT)/bin/$*-ranlib
obj_zlib/%/.lc_configured: | obj_zlib/%/ src_zlib install-llvm install-configs_%
	cd obj_zlib/$* && sh ../../src_zlib/configure --prefix= --static
	touch $@

obj_zlib/%/.lc_built: | obj_zlib/%/.lc_configured
	cd obj_zlib/$* && $(MAKE) AR='$(DESTDIR)$(OUTPUT)/bin/$*-ar' ARFLAGS=rc RANLIB='$(DESTDIR)$(OUTPUT)/bin/$*-ranlib'
	touch $@

obj_zlib/.lc_built: | obj_zlib/.lc_configured
	mkdir -p obj_zlib/include obj_zlib/lib
	cd obj_zlib && $(MAKE) DESTDIR=$(CURDIR)/obj_zlib install
	touch $@

obj_zstd/.lc_built: export CC := $(CCACHE) $(CC)
obj_zstd/.lc_built: | obj_zstd/ src_zstd
	cd src_zstd && $(MAKE) lib
	cp src_zstd/lib/libzstd.a obj_zstd/
	cp src_zstd/lib/zstd.h src_zstd/lib/zstd_errors.h obj_zstd/
	touch $@

obj_libxml2/.lc_configured: export CC := $(CCACHE) $(CC)
obj_libxml2/.lc_configured: | obj_libxml2/ src_libxml2 obj_zlib/.lc_built
	cd obj_libxml2 && sh ../src_libxml2/configure \
		--prefix= \
		--host=`sh ../src_libxml2/config.guess` \
		--disable-shared \
		--enable-static \
		--disable-dependency-tracking \
		--without-catalog \
		--without-debug \
		--without-mem-debug \
		--without-modules \
		--without-ftp \
		--without-http \
		--without-html \
		--without-iconv \
		--without-history \
		--without-legacy \
		--without-python \
		--without-readline \
		--without-modules \
		--without-lzma \
		--with-zlib=$(CURDIR)/obj_zlib
	touch $@

obj_libxml2/.lc_built: | obj_libxml2/.lc_configured
	mkdir -p obj_libxml2/include obj_libxml2/lib
	cd obj_libxml2 && $(MAKE) install DESTDIR=$(CURDIR)/obj_libxml2
	touch $@

# Some configure tests for llvm runtimes fail without crtbegin and
# crtend files in the sysroot. The runtimes build generates these files
# leading to a chicken-egg problem.
obj_sysroot/%/.lc_crt_workaround:
	mkdir -p obj_sysroot/$*/lib
	cd obj_sysroot/$*/lib && touch crtbeginT.o crtbeginS.o crtbegin.o crtend.o crtendS.o
	touch $@

obj_kernel_headers/%/.lc_built: | src_kernel_headers
	mkdir -p $(CURDIR)/obj_kernel_headers/$*/staged
	cd src_kernel_headers && $(MAKE) ARCH=$(call fn_linux_arch,$*) O=$(CURDIR)/obj_kernel_headers/$* INSTALL_HDR_PATH=$(CURDIR)/obj_kernel_headers/$*/staged CC="$(CCACHE) $(CC)" HOSTCC="$(CCACHE) $(HOSTCC)" headers_install
	find obj_kernel_headers/$*/staged/include '(' -name .install -o -name ..install.cmd ')' -exec rm {} +
	touch $@

obj_sysroot/%/.lc_linux_headers: | obj_kernel_headers/%/.lc_built
	mkdir -p obj_sysroot/$*/include
	cp -R obj_kernel_headers/$*/staged/include/* obj_sysroot/$*/include
	touch $@

obj_llvm/.lc_built_3: | $(foreach t,$(TARGETS),obj_musl/$(t)/.lc_built \
						obj_sysroot/$(t)/.lc_crt_workaround \
						obj_sysroot/$(t)/.lc_linux_headers) \
						$(foreach t,$(MINGW_TARGETS),obj_sysroot/$(t)/.lc_mingw_crt)
	cd obj_llvm && ninja runtimes
	touch $@

install-llvm: | obj_llvm/.lc_built_3
	cd obj_llvm && DESTDIR=$(DESTDIR)$(OUTPUT) ninja install-distribution install-builtins install-runtimes

install-musl_%: | obj_musl/%/.lc_built
	cd obj_musl/$* && $(MAKE) $(MUSL_VARS) DESTDIR=$(DESTDIR)$(OUTPUT)/$* install
	cd $(DESTDIR)$(OUTPUT)/$*/lib && $(FIX_LIB_SYMLINKS)

install-zlib_%: | obj_zlib/%/.lc_built
	cd obj_zlib/$* && $(MAKE) DESTDIR=$(DESTDIR)$(OUTPUT)/$* install

install-kernel-headers_%: | obj_kernel_headers/%/.lc_built
	mkdir -p $(DESTDIR)$(OUTPUT)/$*/include
	cp -R obj_kernel_headers/$*/staged/include/* $(DESTDIR)$(OUTPUT)/$*/include

# Real-file anchor so install-configs never races install-llvm under -j
$(DESTDIR)$(OUTPUT)/clang/bin/clang: install-llvm
	@test -f $@ || { echo "expected $@ after install-llvm" >&2; exit 1; }

# llvm 16+ has only the major version number in the resource dir
WIN_RESOURCE_VER = $(if $(intcmp $(call fn_major_version,$(LLVM_VER)),16),$(LLVM_VER),$(call fn_major_version,$(LLVM_VER)))

obj_winbuiltins/%/.lc_built: | obj_winbuiltins/%/ src_llvm obj_llvm/.lc_built_1
	cd obj_winbuiltins/$* && \
	printf 'void __compilerrt_abort_impl(const char*f,int l,const char*fn){__builtin_trap();}\n' > int_abort.c && \
	../../obj_llvm/bin/clang --target=$* -O2 -fno-builtin -c -o int_abort.obj int_abort.c && \
	for n in $(WIN_BUILTIN_GENERIC_SRCS); do \
		../../obj_llvm/bin/clang --target=$* -O2 -fno-builtin -c -o $$n.obj ../../src_llvm/compiler-rt/lib/builtins/$$n.c || exit 1; \
	done && \
	for n in $(WIN_BUILTIN_SRCS_$(WIN_BUILTIN_ARCH_$*)); do \
		../../obj_llvm/bin/clang --target=$* -O2 -fno-builtin -c -o $$n.obj ../../src_llvm/compiler-rt/lib/builtins/$(WIN_BUILTIN_ARCH_$*)/$$n.c || exit 1; \
	done && \
	../../obj_llvm/bin/llvm-ar rc clang_rt.builtins.lib *.obj
	touch $@

install-winbuiltins_%: | obj_winbuiltins/%/.lc_built
	mkdir -p $(DESTDIR)$(OUTPUT)/clang/lib/clang/$(WIN_RESOURCE_VER)/lib/$*
	cp obj_winbuiltins/$*/clang_rt.builtins.lib $(DESTDIR)$(OUTPUT)/clang/lib/clang/$(WIN_RESOURCE_VER)/lib/$*/

# ---- mingw-w64 (windows-gnu) ----

# windres-style frontend for llvm-rc: mingw-w64's autotools invoke the RC
# compiler as `RC -i IN -o OUT --include DIR`, llvm-rc wants MSRC syntax.
define MINGW_RCWRAP
#!/bin/sh
in= out=; iargs=
while [ $$# -gt 0 ]; do
  case "$$1" in
    -i) in=$$2; shift 2;;
    -o) out=$$2; shift 2;;
    --include|-I) iargs="$$iargs /I $$2"; shift 2;;
    *) iargs="$$iargs $$1"; shift;;
  esac
done
exec "$$(dirname $$0)/obj_llvm/bin/llvm-rc" $$iargs "$$in" /FO "$$out"
endef

obj_mingw_rcwrap: | obj_llvm/.lc_built_1
	$(file >$@,$(MINGW_RCWRAP))
	chmod +x $@

# Point every autotools probe at the built LLVM tools
# absolute tool paths: mingw-w64's make recurses into subdirectories where
# ../../ relative paths would break
MINGW_CROSSVARS = \
	CC='$(CCACHE) $(CURDIR)/obj_llvm/bin/clang --target=$*' \
	CFLAGS='$(COMMON_FLAGS)' \
	CPPFLAGS='-I$(CURDIR)/obj_sysroot/$*/include' \
	LDFLAGS='-L$(CURDIR)/obj_sysroot/$*/lib' \
	AR='$(CURDIR)/obj_llvm/bin/llvm-ar' \
	RANLIB='$(CURDIR)/obj_llvm/bin/llvm-ranlib' \
	NM='$(CURDIR)/obj_llvm/bin/llvm-nm' \
	AS='$(CURDIR)/obj_llvm/bin/clang --target=$*' \
	LD='$(CURDIR)/obj_llvm/bin/ld.lld' \
	DLLTOOL='$(CURDIR)/obj_llvm/bin/llvm-dlltool' \
	RC='$(CURDIR)/obj_mingw_rcwrap -I $(CURDIR)/obj_sysroot/$*/include' \
	STRIP='$(CURDIR)/obj_llvm/bin/llvm-strip' \
	OBJDUMP='$(CURDIR)/obj_llvm/bin/llvm-objdump'

obj_mingw_headers/%/.lc_configured: | obj_mingw_headers/%/ src_mingw
	cd obj_mingw_headers/$* && sh ../../src_mingw/mingw-w64-headers/configure \
		--prefix= --host=$* --enable-sdk=all --enable-idl --enable-secure-api --with-sysroot=/ \
		|| (cat config.log && exit 1)
	touch $@

obj_sysroot/%/.lc_mingw_headers: | obj_mingw_headers/%/.lc_configured
	cd obj_mingw_headers/$* && $(MAKE) DESTDIR=$(CURDIR)/obj_sysroot/$* install
	touch $@

obj_mingw_crt/%/.lc_configured: | obj_mingw_crt/%/ src_mingw obj_sysroot/%/.lc_mingw_headers obj_llvm/.lc_built_1 obj_mingw_rcwrap
	cd obj_mingw_crt/$* && sh ../../src_mingw/mingw-w64-crt/configure \
		--prefix= --host=$* --with-sysroot=/ $(MINGW_CRT_CONFIG_$*) $(MINGW_CROSSVARS) \
		|| (cat config.log && exit 1)
	touch $@

obj_mingw_crt/%/.lc_built: | obj_mingw_crt/%/.lc_configured
	cd obj_mingw_crt/$* && $(MAKE)
	touch $@

obj_sysroot/%/.lc_mingw_crt: | obj_mingw_crt/%/.lc_built
	cd obj_mingw_crt/$* && $(MAKE) DESTDIR=$(CURDIR)/obj_sysroot/$* install
	touch $@

obj_mingw_pthreads/%/.lc_configured: | obj_mingw_pthreads/%/ src_mingw obj_sysroot/%/.lc_mingw_crt obj_mingw_rcwrap
	cd obj_mingw_pthreads/$* && sh ../../src_mingw/mingw-w64-libraries/winpthreads/configure \
		--prefix= --host=$* --with-sysroot=/ $(MINGW_CROSSVARS) \
		|| (cat config.log && exit 1)
	touch $@

obj_mingw_pthreads/%/.lc_built: | obj_mingw_pthreads/%/.lc_configured
	cd obj_mingw_pthreads/$* && $(MAKE)
	touch $@

install-mingw_%: | obj_sysroot/%/.lc_mingw_headers obj_mingw_crt/%/.lc_built obj_mingw_pthreads/%/.lc_built
	cd obj_mingw_headers/$* && $(MAKE) DESTDIR=$(DESTDIR)$(OUTPUT)/$* install
	cd obj_mingw_crt/$* && $(MAKE) DESTDIR=$(DESTDIR)$(OUTPUT)/$* install
	cd obj_mingw_pthreads/$* && $(MAKE) DESTDIR=$(DESTDIR)$(OUTPUT)/$* install


# The driver looks up implicit config files by the *normalized* form of the
# triple the wrapper was invoked as (arm-linux-musleabihf-clang reads
# arm-unknown-linux-musleabihf-clang.cfg next to the real binary), so ask
# clang itself for the exact name it will search for. <CFGDIR> expands to the
# directory holding the .cfg, keeping the sysroot next to the install and the
# toolchain relocatable; this replaces the DEFAULT_SYSROOT patch.
install-configs_%: $(DESTDIR)$(OUTPUT)/clang/bin/clang
	triple=$$($(DESTDIR)$(OUTPUT)/clang/bin/clang --target=$* -print-target-triple); \
	echo "--target=$* --sysroot=<CFGDIR>/../../$* $(TARGET_CONFIG_$*)" > $(DESTDIR)$(OUTPUT)/clang/bin/$$triple-clang.cfg; \
	echo "--target=$* --sysroot=<CFGDIR>/../../$* $(TARGET_CONFIG_$*)" > $(DESTDIR)$(OUTPUT)/clang/bin/$$triple-clang++.cfg

install-symlinks_%: | $(DESTDIR)$(OUTPUT)/bin/
	cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/clang $*-clang
	cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/clang++ $*-clang++
	cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/clang-cpp $*-cpp
	cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/clang $*-cc
	cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/clang++ $*-c++
	cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/ld.lld $*-ld
	$(foreach t,$(TOOLS),cd $(DESTDIR)$(OUTPUT)/bin && ln -sf ../clang/bin/$(t) $*-$(subst llvm-,,$(t);))

clean:
	rm -rf src_* obj_*

# $(call fn_linux_arch,target-triple)
#	Determine linux architecture from target triple
ifeq ($(LINUX_SRCDIR),)
$(error LINUX_SRCDIR is required for llvm libc++ build)
endif
LINUX_ARCH_LIST := $(sort $(notdir $(wildcard $(LINUX_SRCDIR)/arch/*)))
fn_target_arch = $(firstword $(subst -, ,$(1)))
fn_target_arch_mangled = $(patsubst i%86,x86,$(patsubst aarch64%,arm64%,$(call fn_target_arch,$(1))))
fn_linux_arch = $(lastword $(foreach a,$(LINUX_ARCH_LIST),$(if $(filter $(a)%,$(call fn_target_arch_mangled,$(1))),$(a))))

.SECONDARY:
