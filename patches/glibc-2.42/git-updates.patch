+	tst	r4, #HWCAP_ARM_VFPD32
+	beq	2f
+	.inst	0xecf30b20	@ vldmia r3!, {d16-d31}
+2:	ldr	r2, [r3]
+	.inst	0xeee12a10	@ vmsr fpscr, r2
+	add	sp, sp, VFP_STACK_REQ
+	cfi_adjust_cfa_offset (-VFP_STACK_REQ)
