+#ifdef SHARED
+	@ Preserve all call-clobbered VFP registers across _dl_fixup.
+	@ VFP may be used by IFUNC resolvers, audit modules, interposed
+	@ malloc, and the __aeabi_mem* helpers required by RTABI32,
